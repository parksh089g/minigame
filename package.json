{
  "name": "pocket-arcade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "온·오프라인에서 즐기는 말랑한 미니게임 모음 (PWA)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "server": "wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.160.0"
  }
}
