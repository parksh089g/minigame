// Cloudflare Workers 배포 설정.
// Cloudflare가 저장소를 읽어 `npm run build`로 빌드한 뒤 `npx wrangler deploy`로 dist/ 를 올린다.
{
  // Cloudflare 대시보드의 프로젝트 이름과 같아야 한다. 다르면 빌드가 실패한다.
  "name": "minigame",
  "compatibility_date": "2026-11-01",
  // 서버 코드 없이 빌드 결과물만 정적 파일로 제공한다.
  "assets": {
    "directory": "./dist"
  },
  // main이 아닌 브랜치를 올리면 Cloudflare가 `npx wrangler preview`로 미리보기를 만든다.
  // 이 블록이 없으면 그 명령이 실패한다. 미리보기에만 쓸 설정이 없으므로 비워 둔다.
  "previews": {}
}
