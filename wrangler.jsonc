// Cloudflare Workers 배포 설정.
// Cloudflare가 저장소를 읽어 `npm run build`로 빌드한 뒤 `npx wrangler deploy`로 올린다.
{
  // Cloudflare 대시보드의 프로젝트 이름과 같아야 한다. 다르면 빌드가 실패한다.
  "name": "minigame",
  "compatibility_date": "2026-11-01",
  // 랭킹과 기기 옮기기를 맡는 작은 서버. /api/ 로 시작하는 요청만 처리한다.
  "main": "./worker/index.ts",
  // 게임 파일은 빌드 결과물을 그대로 내려 준다. 맞는 파일이 없는 요청만 서버 코드로 넘어간다.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // 랭킹과 옮기기 코드를 저장하는 Durable Object(worker/board.ts). 무료 요금제에서 쓸 수 있는 SQLite 저장소를 쓴다.
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "ArcadeBoard" }]
  },
  "exports": {
    "ArcadeBoard": { "type": "durable-object", "storage": "sqlite" }
  },
  // main이 아닌 브랜치를 올리면 Cloudflare가 `npx wrangler preview`로 미리보기를 만든다.
  // 이 블록이 없으면 그 명령이 실패한다. 미리보기는 위의 설정을 물려받지 않으므로 서버가 쓰는 저장소를 여기에도 적는다.
  // 미리보기마다 저장소가 따로 생기므로, 미리보기에서 올린 점수는 실제 랭킹에 섞이지 않는다.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "BOARD", "class_name": "ArcadeBoard" }]
    }
  }
}
